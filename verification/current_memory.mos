loadModel(Modelica, {"4.1.0"}); getErrorString();
loadFile("autolavado.mo"); getErrorString();
mkdir("verification/current");
cd("verification/current");
simulate(autolavado.SelfServiceCarWashTest,stopTime=64,numberOfIntervals=3200,tolerance=1e-6,outputFormat="csv",fileNamePrefix="CurrentCycle");
getErrorString();
